{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src/main/ts",
    "sourceMap": true,
    "strict": true
  },
  "include": ["src/main/ts/**/*.ts"]
}
